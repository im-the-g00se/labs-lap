{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/LinearAlgebra.Tests/LinearAlgebra.Tests.csproj",
                "--configuration",
                "Debug",
                "--disable-build-servers",
                "-m:1"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DOTNET_CLI_HOME": "${workspaceFolder}/.dotnet-home",
                    "NUGET_PACKAGES": "${workspaceFolder}/.nuget/packages",
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
                }
            },
            "osx": {
                "command": "${env:HOME}/.dotnet/dotnet"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-demo",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/VectorDemo/VectorDemo.csproj",
                "--configuration",
                "Debug",
                "--disable-build-servers",
                "-m:1"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DOTNET_CLI_HOME": "${workspaceFolder}/.dotnet-home",
                    "NUGET_PACKAGES": "${workspaceFolder}/.nuget/packages",
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
                }
            },
            "osx": {
                "command": "${env:HOME}/.dotnet/dotnet"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
